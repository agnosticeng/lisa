	<string>Lisa can serve its local model to clients on your network when you enable the API server.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Lisa uses the microphone when you dictate a message.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lisa transcribes dictated messages with on-device speech recognition.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
