               gguf_nibble_pairs((qs[4 + c] >> (4 * (j % 2))) & 0x0F0F0F0Fu) << 8;
  *(device uint4 *)out0 = pairs;
  if (fifth) {
    device const uint *qh = (device const uint *)(blk + 16);
